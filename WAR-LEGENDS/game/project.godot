; WAR LEGENDS — Offline Arabic-first tactical arena
; Engine target: Godot 4.7.2 stable
config_version=5

[application]
config/name="WAR LEGENDS — حصن الفجر"
config/description="معركة استراتيجية ثلاثية الأبعاد تعمل بلا اتصال"
config/icon="res://assets/icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/version="0.1.0"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/handheld/orientation=1
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.043, 0.078, 0.09, 1)

[physics]
3d/default_gravity=9.8
